# Copy this file to looker-env/.env and fill in your Looker API 4.0 keys.
# Do not commit looker-env/.env.

# Used by main.py (Looker Python SDK)
LOOKERSDK_BASE_URL=https://your-instance.looker.com
LOOKERSDK_CLIENT_ID=
LOOKERSDK_CLIENT_SECRET=

# Used by the Cursor MCP Toolbox server
LOOKER_BASE_URL=https://your-instance.looker.com
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
LOOKER_VERIFY_SSL=true
